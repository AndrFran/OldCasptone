# Environment Configuration
# Copy this to .env and fill in actual values

# Environment
ENV=development
DEBUG=true

# JWT signing key — REQUIRED when ENV=production (backend refuses to start otherwise).
# Generate a strong value: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never commit the real key.
SECRET_KEY=

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/vibestrike

# API
API_PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
